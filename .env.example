# Exemple de configuration. Copier en .env ; ce fichier ne contient aucun secret.
# Le mot de passe de l'application se crée dans l'interface, jamais ici.

# Dossier des données (base chiffrée). Dans Docker : le volume monté sur /data.
FINANCE_DATA_DIR=/data

# Adresse d'écoute. 127.0.0.1 : accès depuis la machine seulement (défaut sûr).
FINANCE_HOST=127.0.0.1
FINANCE_PORT=8000
